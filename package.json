{
  "name": "agentwatch-repository",
  "private": true,
  "type": "module",
  "description": "Repository-only Bun scripts for packages/agentwatch; not a distribution package.",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "typecheck": "bun run --cwd packages/agentwatch typecheck",
    "test": "bun run --cwd packages/agentwatch test",
    "build": "bun run --cwd packages/agentwatch build",
    "build:test-host": "bun run --cwd packages/agentwatch build:test-host",
    "verify": "bun run --cwd packages/agentwatch verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/younglark/agentwatch.git"
  }
}
