{
  "name": "@agentwatch/task-core",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "bun node_modules/typescript/bin/tsc6 --noEmit",
    "test": "bun test test/core.test.ts test/cli.test.ts test/auth.test.ts test/auth-boundaries.test.ts test/auth-refresh-interleavings.test.ts test/auth-legacy-session.test.ts test/auth-metadata-migration.test.ts",
    "build": "bun build --compile --define AGENTWATCH_COMPILED=true src/main.ts --outfile dist/agentwatch",
    "verify": "bun run typecheck && bun run test && bun run build && bun run build:test-host && bun test test/compiled.test.ts",
    "build:test-host": "bun build --compile --define TEST_HOST_COMPILED=true test/host.ts --outfile dist/test-host"
  },
  "dependencies": {
    "effect": "4.1.0",
    "@effect/platform-bun": "4.1.0",
    "@effect/sql-sqlite-bun": "4.1.0",
    "drizzle-orm": "1.0.0-rc.5-169397b"
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@types/bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "@effect/platform-node-shared": "4.1.0",
    "@types/node": "24.12.2"
  },
  "version": "0.1.0",
  "bin": {
    "agentwatch-next": "./dist/agentwatch"
  },
  "files": [
    "dist/agentwatch"
  ]
}
